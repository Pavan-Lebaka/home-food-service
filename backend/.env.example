# ==============================================================
# Bramarambika Home Foods - Backend Environment Template
# ==============================================================

PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-store.vercel.app,https://your-admin.vercel.app,http://localhost:5173,http://localhost:5174

# Cryptographic Hex Secret Keys (Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))')
HEX_SECRET_KEY=generate_64_character_hex_key_here
JWT_SECRET=generate_64_character_hex_key_here
JWT_EXPIRES_IN=7d

# Admin Portal Credentials
ADMIN_EMAIL=admin@yourkitchen.com
ADMIN_PASSWORD=your_strong_admin_password

# Supabase Database Credentials (from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Shiprocket Courier API Integration
SHIPROCKET_EMAIL=your_shiprocket_account_email@gmail.com
SHIPROCKET_PASSWORD=your_shiprocket_account_password
SHIPROCKET_PICKUP_PINCODE=518001
SHIPROCKET_PICKUP_LOCATION=Bramarambika_Kitchen
WHATSAPP_NUMBER=7793910819
UPI_ID=7793910819@ybl
